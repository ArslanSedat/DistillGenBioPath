# Copy to .env and fill in the paths for your machine.

# Directory of training whole-slide images (.dcm files).
DATA_DIR=
# Optional held-out slides for validation. Leave empty to disable validation.
VAL_DATA_DIR=
# Where run outputs and training checkpoints are written. Exported student weights
# are written here only when WEIGHTS_DIR below is left empty.
OUTPUT_DIR=outputs

# Directory holding model weights as <model_name>.pth. Teacher and student weights
# are read from here (e.g. $WEIGHTS_DIR/model.pth). When this is set, distilled
# student backbones are written here too.
WEIGHTS_DIR=

# Weights & Biases logging. Runs log to your W&B account by default; set
# WANDB_MODE=offline to log locally without an account, or =disabled to turn it off.
WANDB_PROJECT=distillgenbiopath
# WANDB_MODE=